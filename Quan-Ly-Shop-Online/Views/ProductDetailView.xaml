<Window x:Class="Quan_Ly_Shop_Online.Views.ProductDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết hàng hóa"
        Width="760"
        Height="700"
        MinWidth="620"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="349*"/>
            <ColumnDefinition Width="363*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="50" Background="#DBEAFE" CornerRadius="12">
                <Image Width="26" Height="26"
                       Source="pack://application:,,,/Quan-Ly-Shop-Online;component/Assets/product.png" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Chi tiết hàng hóa" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Xem và cập nhật thông tin hàng hóa." />
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="{Binding ProductId}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Thông tin hàng hóa" />
                    <TextBlock Margin="0,5,0,22"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Mã hàng được giữ nguyên khi lưu thay đổi." />

                    <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Mã hàng" />
                    <TextBox Margin="0,0,0,18"
                             Background="#F8FAFC"
                             IsReadOnly="True"
                             Style="{StaticResource DialogTextBoxStyle}"
                             Text="{Binding ProductId, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Tên hàng hóa *" />
                    <TextBox Margin="0,0,0,18"
                             AutomationProperties.Name="Tên hàng hóa"
                             MaxLength="50"
                             Style="{StaticResource DialogTextBoxStyle}"
                             Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Danh Mục *" />
                            <ComboBox Height="44"
                                      AutomationProperties.Name="Danh Mục"
                                      IsEditable="True"
                                      ItemsSource="{Binding Categories}"
                                      MaxDropDownHeight="200"
                                      Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,18">
                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Tồn kho *" />
                            <TextBox AutomationProperties.Name="Tồn kho"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Giá nhập (₫) *" />
                            <TextBox AutomationProperties.Name="Giá nhập"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding ImportPrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="Giá bán (₫) *" />
                            <TextBox AutomationProperties.Name="Giá bán"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" Grid.ColumnSpan="2">
            <TextBlock Margin="0,0,0,12"
                       Foreground="#DC2626"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Height="44"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"
                        Content="Hủy"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Template="{StaticResource RoundedButtonTemplate}" />
                <Button Height="44"
                        MinWidth="150"
                        Command="{Binding SaveCommand}"
                        Content="Lưu thay đổi"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Template="{StaticResource RoundedButtonTemplate}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
