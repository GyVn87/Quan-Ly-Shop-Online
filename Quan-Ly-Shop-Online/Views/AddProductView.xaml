<Window x:Class="Quan_Ly_Shop_Online.Views.AddProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm hàng hóa"
        Width="1120"
        Height="720"
        MinWidth="940"
        MinHeight="620"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="BareDialogTextBoxStyle"
               BasedOn="{StaticResource DialogTextBoxStyle}"
               TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Foreground" Value="#334155" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImageSlotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="86" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <ControlTemplate x:Key="DialogFooterButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}" />
            </Border>
        </ControlTemplate>

        <Style x:Key="DialogPrimaryButtonStyle"
               BasedOn="{StaticResource PrimaryButtonStyle}"
               TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template" Value="{StaticResource DialogFooterButtonTemplate}" />
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle"
               BasedOn="{StaticResource SecondaryButtonStyle}"
               TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template" Value="{StaticResource DialogFooterButtonTemplate}" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Opacity="0.22"
                                  ShadowDepth="8" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="82" />
                </Grid.RowDefinitions>

                <Border BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                    <Grid Margin="30,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Width="30"
                              Height="30"
                              VerticalAlignment="Center"
                              Data="M4,7 L16,1 L28,7 L28,23 L16,29 L4,23 Z M4,7 L16,13 L28,7 M16,13 L16,29"
                              Stretch="Uniform"
                              Stroke="#334155"
                              StrokeLineJoin="Round"
                              StrokeThickness="2" />
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Thêm hàng hóa" />
                        <Button Grid.Column="2"
                                Command="{Binding CancelCommand}"
                                Content="×"
                                Style="{StaticResource HeaderIconButtonStyle}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="32,24,32,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="7*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Button Height="330"
                                    Command="{Binding SelectImagesCommand}"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Rectangle RadiusX="14"
                                                       RadiusY="14"
                                                       Stroke="#94A3B8"
                                                       StrokeDashArray="5,4"
                                                       StrokeThickness="1.5" />
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="58" Height="58" HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="46"
                                                   Foreground="#475569"
                                                   Text="☁" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="#475569"
                                                   Text="↑" />
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Tải lên hình ảnh" />
                                    <TextBlock Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               Foreground="#475569"
                                               Text="Nhấn để chọn ảnh" />
                                    <TextBlock Margin="0,9,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="JPG, PNG, WebP (tối đa 5MB/ảnh)" />
                                </StackPanel>
                            </Button>

                            <StackPanel Margin="0,14,0,0"
                                        Orientation="Horizontal">
                                <Button Command="{Binding SelectImagesCommand}"
                                        Style="{StaticResource ImageSlotButtonStyle}">
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="28"
                                                   Foreground="#334155"
                                                   Text="＋" />
                                        <TextBlock Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#334155"
                                                   Text="Thêm ảnh" />
                                    </StackPanel>
                                </Button>

                                <ItemsControl Margin="8,0,0,0"
                                              ItemsSource="{Binding ImagePaths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="86"
                                                    Height="82"
                                                    Margin="0,0,8,0"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Image Margin="5"
                                                           Source="{Binding}"
                                                           Stretch="UniformToFill" />
                                                    <Button Width="22"
                                                            Height="22"
                                                            Margin="0,4,4,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#CCFFFFFF"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="×"
                                                            Cursor="Hand" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EmptyImageSlots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="86"
                                                    Height="82"
                                                    Margin="0,0,8,0"
                                                    Background="#F8FAFC"
                                                    CornerRadius="8">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="25"
                                                           Foreground="#94A3B8"
                                                           Text="▧" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource DialogLabelStyle}">
                                <Run Text="Tên hàng hóa " />
                                <Run Foreground="#DC2626" Text="*" />
                            </TextBlock>
                            <Grid>
                                <TextBox x:Name="ProductNameTextBox"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"
                                           Text="Nhập tên hàng hóa">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ProductNameTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Margin="0,18,0,7"
                                       Style="{StaticResource DialogLabelStyle}"
                                       Text="Mô tả" />
                            <Grid>
                                <TextBox x:Name="DescriptionTextBox"
                                         Height="86"
                                         Padding="13,10"
                                         AcceptsReturn="True"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" />
                                <TextBlock Margin="14,11,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"
                                           Text="Nhập mô tả về hàng hóa...">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=DescriptionTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource DialogLabelStyle}">
                                        <Run Text="Giá nhập " />
                                        <Run Foreground="#DC2626" Text="*" />
                                    </TextBlock>
                                    <Border Height="44"
                                            Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#475569"
                                                           Text="₫" />
                                            </Border>
                                            <Grid Grid.Column="1">
                                                <TextBox x:Name="PurchasePriceTextBox"
                                                         Style="{StaticResource BareDialogTextBoxStyle}"
                                                         Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="13,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#94A3B8"
                                                           IsHitTestVisible="False"
                                                           Text="Nhập giá nhập">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=PurchasePriceTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource DialogLabelStyle}">
                                        <Run Text="Giá bán " />
                                        <Run Foreground="#DC2626" Text="*" />
                                    </TextBlock>
                                    <Border Height="44"
                                            Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#475569"
                                                           Text="₫" />
                                            </Border>
                                            <Grid Grid.Column="1">
                                                <TextBox x:Name="SalePriceTextBox"
                                                         Style="{StaticResource BareDialogTextBoxStyle}"
                                                         Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="13,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#94A3B8"
                                                           IsHitTestVisible="False"
                                                           Text="Nhập giá bán">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=SalePriceTextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DialogLabelStyle}">
                                        <Run Text="Số lượng " />
                                        <Run Foreground="#DC2626" Text="*" />
                                    </TextBlock>
                                    <Border Height="44"
                                            Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource BareDialogTextBoxStyle}"
                                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding IncreaseQuantityCommand}"
                                                        Content="⌃"
                                                        Cursor="Hand"
                                                        Foreground="#64748B" />
                                                <Button Grid.Row="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DecreaseQuantityCommand}"
                                                        Content="⌄"
                                                        Cursor="Hand"
                                                        Foreground="#64748B" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,18,0,7" Style="{StaticResource DialogLabelStyle}">
                                <Run Text="Tag" />
                                <Run Foreground="#64748B" Text="  ⓘ" />
                            </TextBlock>
                            <Grid>
                                <TextBox x:Name="TagInputTextBox"
                                         Style="{StaticResource DialogTextBoxStyle}"
                                         Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False"
                                           Text="Nhập tag và nhấn Enter để thêm">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TagInputTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,7,7"
                                                Padding="10,5"
                                                Background="#DBEAFE"
                                                CornerRadius="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8"
                                                           Text="{Binding}" />
                                                <Button Margin="7,0,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="×"
                                                        Cursor="Hand"
                                                        Foreground="#1D4ED8" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="32,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock MaxWidth="470"
                                   VerticalAlignment="Center"
                                   Foreground="#DC2626"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                MinWidth="86"
                                Margin="0,16,10,16"
                                Command="{Binding CancelCommand}"
                                Content="Hủy"
                                Style="{StaticResource DialogSecondaryButtonStyle}" />
                        <Button Grid.Column="2"
                                MinWidth="134"
                                Margin="0,16,0,16"
                                Command="{Binding SubmitCommand}"
                                Content="Thêm hàng hóa"
                                Style="{StaticResource DialogPrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
