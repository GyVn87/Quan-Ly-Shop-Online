<UserControl x:Class="Quan_Ly_Shop_Online.Views.GoodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Padding="10,4"
                                Background="#DBEAFE"
                                CornerRadius="10">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="QUẢN LÝ KHO" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Hàng hóa" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Theo dõi tồn kho, giá bán và tình trạng hàng hóa của cửa hàng." />
                </StackPanel>
                <Button Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        VerticalContentAlignment="Center"
                        Command="{Binding AddProductCommand}"
                        Content="＋  Thêm hàng hóa"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <UniformGrid Grid.Row="1" Margin="0,28,0,22" Columns="3">
                <Border Margin="0,0,14,0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Tổng mặt hàng" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding TotalProducts}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   Text="Đang được theo dõi" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,14,0" 
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Sắp hết hàng" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="#D97706"
                                   Text="{Binding LowStockCount}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Cần được bổ sung sớm" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Danh mục" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="#7C3AED"
                                   Text="{Binding CategoryCount}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   Text="Nhóm hàng đang quản lý" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,7" 
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="TÌM KIẾM HÀNG HÓA" />
                        <Grid>
                            <TextBox Height="42"
                                     Padding="38,9,12,9"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm theo mã hoặc tên hàng" />
                            <TextBlock Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsHitTestVisible="False" Text="⌕" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,7"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="DANH MỤC" />
                        <ComboBox Height="42"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  ToolTip="Lọc theo danh mục" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" 
                    Margin="0,18,0,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Danh sách hàng hóa" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Dữ liệu đang hiển thị theo điều kiện tìm kiếm và danh mục." />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#DC2626"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" 
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Background="#F1F5F9"
                                CornerRadius="10">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding ResultCount, StringFormat={}{0} kết quả}" />
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Margin="0,20,0,0"
                              MinHeight="310"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding FilteredProducts}"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" 
                                                    Header="MÃ HÀNG">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Id}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2*"
                                                    Header="TÊN HÀNG">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ProductName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*"
                                                    Header="DANH MỤC">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,0"
                                                Padding="9,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="#F1F5F9"
                                                CornerRadius="9">
                                            <TextBlock FontSize="13" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding Category}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*"
                                                    Header="GIÁ BÁN">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Price, StringFormat={}{0:N0} ₫}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" Header="TỒN KHO">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Stock, StringFormat={}{0} sản phẩm}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="112" Header="THAO TÁC" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    AutomationProperties.Name="Sửa hàng hóa"
                                                    Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    ToolTip="Xem và sửa hàng hóa">
                                                <Image Width="16" Height="16"
                                                       Source="pack://application:,,,/Quan-Ly-Shop-Online;component/Assets/edit.png" />
                                            </Button>
                                            <Button AutomationProperties.Name="Xóa hàng hóa"
                                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    ToolTip="Xóa hàng hóa">
                                                <Image Width="16" Height="16"
                                                       Source="pack://application:,,,/Quan-Ly-Shop-Online;component/Assets/delete.png" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
