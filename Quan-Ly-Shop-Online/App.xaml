<Application x:Class="Quan_Ly_Shop_Online.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Quan_Ly_Shop_Online.ViewModels"
             xmlns:views="clr-namespace:Quan_Ly_Shop_Online.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:GoodsViewModel}">
                <views:GoodsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
