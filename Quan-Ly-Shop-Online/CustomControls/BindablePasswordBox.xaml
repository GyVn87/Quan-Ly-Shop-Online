<UserControl x:Class="Quan_Ly_Shop_Online.CustomControls.BindablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quan_Ly_Shop_Online.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <PasswordBox x:Name="BindablePasswordBoxControl"
                 PasswordChanged="OnPasswordChange"
                 Height="30"
                 FontSize="20" 
                 BorderThickness="0" 
                 VerticalContentAlignment="Center" 
                 Background="Transparent"/>
</UserControl>
